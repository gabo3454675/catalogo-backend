generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String?  @unique
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(12, 2)
  sourcePriceBs Decimal? @db.Decimal(14, 2)
  exchangeRate  Decimal? @db.Decimal(14, 6)
  markupUsd     Decimal  @default(0) @db.Decimal(12, 2)
  available   Boolean  @default(true)
  imageUrl    String?
  images      ProductImage[]
  sourceUrl   String?
  categoryId  String
  brandId     String?
  productType String?
  category    Category @relation(fields: [categoryId], references: [id])
  brand       Brand?   @relation(fields: [brandId], references: [id])
  sales       Sale[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([name])
  @@index([productType])
  @@index([available])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId])
}

model SyncRun {
  id             String   @id @default(cuid())
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  status         String
  productsFound  Int      @default(0)
  productsAdded  Int      @default(0)
  productsUnavailable Int @default(0)
  exchangeRate   Decimal? @db.Decimal(14, 6)
  rateUpdatedAt  DateTime?
  error          String?
  additions      SyncAddition[]
  sightings      SyncSighting[]
}

model SyncAddition {
  id          String   @id @default(cuid())
  syncRunId   String
  productId   String
  productName String
  sku         String?
  createdAt   DateTime @default(now())
  syncRun     SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
}

model SyncSighting {
  id        String  @id @default(cuid())
  syncRunId String
  sku       String
  syncRun   SyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@unique([syncRunId, sku])
  @@index([syncRunId])
}

model Sale {
  id          String   @id @default(cuid())
  productId   String?
  productName String
  sku         String?
  quantity    Int      @default(1)
  priceUsd    Decimal? @db.Decimal(12, 2)
  note        String?
  soldAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([soldAt])
  @@index([productId])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String
  sessionId   String?
  productId   String?
  productName String?
  path        String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([productId])
  @@index([sessionId])
}
